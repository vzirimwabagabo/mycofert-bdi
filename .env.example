# ─────────────────────────────────────────────────────────────────────────────
# MYCOFERT Burundi — environment template
#
# Copy to `.env` for local development and fill in real values. In production
# set these as deployment secrets; never commit a populated `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────────────────────
# PostgreSQL. The app runs on multiple instances behind a load balancer, so a
# file-based database cannot be used.
#   Local:     postgresql://user:pass@localhost:5432/mycofert
#   Managed:   use the pooled connection string your provider gives you
#              (Neon "-pooler", Supabase "Connection pooling", PgBouncer, ...)
DATABASE_URL="postgresql://user:password@localhost:5432/mycofert"

# DIRECT_URL: Direct (unpooled) connection URL used by Prisma migrations.
#   For Neon, remove "-pooler" from the host.
#   For Supabase, use direct port 5432 instead of pooler port 6543.
DIRECT_URL="postgresql://user:password@localhost:5432/mycofert"

# Optional: Prisma connection pool size PER INSTANCE. Total connections are
# instances × connection_limit, so keep the product below the database's
# max_connections. Managed providers usually want 5–10.
DATABASE_CONNECTION_LIMIT="10"

# ── Admin authentication (required) ─────────────────────────────────────────
# ADMIN_PASSCODE: the INITIAL passphrase for the admin dashboard.
#   Use a long random passphrase (12+ chars). This is the ONLY factor
#   protecting customer data, so treat it like a password, not a code.
#   Generate: openssl rand -base64 24
#
#   IMPORTANT — this value is only used until the passcode is first changed
#   (Admin -> Settings -> Security) or reset with a recovery code. From then on
#   the salted hash in the database wins and this variable is ignored: editing
#   it will NOT recover a forgotten passcode. The supported way back in is the
#   recovery code the owner generates under Admin -> Settings -> "Recovery code";
#   the last resort is deleting the `admin_passcode_hash` row (npm run db:studio).
ADMIN_PASSCODE=""

# ADMIN_SESSION_SECRET: HMAC key used to sign admin session tokens.
#   Must be at least 32 characters, and identical across ALL instances
#   (otherwise tokens issued by one instance fail on another).
#   Generate: openssl rand -base64 48
#   Rotating this value invalidates every existing session.
ADMIN_SESSION_SECRET=""


# ── Proxy / load balancer ────────────────────────────────────────────────────
# TRUST_PROXY="" — default: unset (safe, spoof-proof).
# Set to "1" ONLY when a proxy you FULLY CONTROL sits in front and
# overwrites X-Forwarded-For before it reaches this app.
# Leaving it unset means rate limiting uses a shared bucket for unknown IPs
# (slightly less precise), but it is immune to IP spoofing attacks.
# TRUST_PROXY="1"

# ── Runtime ──────────────────────────────────────────────────────────────────
# NODE_ENV is managed by Next.js — do NOT set it here; it has no effect and
# can cause confusion with build tooling.
# NODE_ENV="production"

# ── Analytics retention ──────────────────────────────────────────────────────
# Days to keep PageView rows. Default 365. Set to 0 to disable pruning.
PAGEVIEW_RETENTION_DAYS="365"

# Optional: Upstash-compatible Redis for cross-instance rate limiting.
# REQUIRED in production (see below). Leave EMPTY in dev — the in-memory
# store is correct for a single instance.
# NEVER put real values here: this file IS tracked by git, so a live token in it
# is a published credential. Set them in the deployment secret store instead.
RATE_LIMIT_REDIS_URL=""
RATE_LIMIT_REDIS_TOKEN=""
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ALLOW_MEMORY_RATE_LIMIT: set to "1" ONLY on a genuinely single-instance
# production deploy where Redis is intentionally absent. Without this flag,
# the startup check will exit(1) when NODE_ENV=production and no Redis URL
# is configured, because per-process counters are not safe behind a load
# balancer. Single-instance deploys that accept this trade-off can opt out:
# ALLOW_MEMORY_RATE_LIMIT="1"

# ── Object storage for uploads (optional, but preferred) ─────────────────────
# Any S3-compatible bucket: Supabase Storage, Neon Object Storage, Cloudflare
# R2, Backblaze B2, AWS S3. When these are set, the admin dashboard uploads
# through a presigned PUT straight from the browser to the bucket — image bytes
# never pass through this app. When they are unset, Cloudinary below is used
# instead, and when THAT is unset too, uploads are disabled and the built-in
# local image library (public/images) keeps working.
#
# All six values are needed together; a partially-filled block is treated as
# "not configured" (deliberately, so a half-set bucket cannot fail at upload
# time with a provider error instead of a clear message).
#
#   Supabase Storage:  endpoint https://<project-ref>.supabase.co/storage/v1/s3
#                      region   the project's region (e.g. eu-central-1)
#                      keys     Storage -> Settings -> S3 Access Keys
#                      public   https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
#   Neon Object Storage: endpoint https://<bucket>.storage.<region>.aws.neon.tech
#                      region   the branch's region
#                      public   the bucket's base URL
#   AWS S3 / R2 / B2:  endpoint the provider's S3 endpoint, region as documented
#
# NOTE — the access keys are SERVER-ONLY secrets. They bypass any RLS/bucket
# policy the provider applies to public keys, so never expose them to the client
# and never prefix them with NEXT_PUBLIC_.
STORAGE_ENDPOINT=""
STORAGE_REGION=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# NEXT_PUBLIC_STORAGE_PUBLIC_URL: the ONLY public value here — it is the base URL
# every visitor's browser already loads images from, so it is not a secret.
# Because it is a NEXT_PUBLIC_ variable it is inlined into the client bundle at
# BUILD time: changing it needs a REBUILD, not just a restart.
NEXT_PUBLIC_STORAGE_PUBLIC_URL=""

# ── Cloudinary image hosting (optional fallback) ─────────────────────────────
# Used only when the object-storage block above is not configured.
# Leave EMPTY to disable uploads; the built-in local image library
# (public/images) keeps working. Do NOT put example/dummy values here:
# they are non-empty, so the app treats Cloudinary as configured and the first
# upload fails with a confusing 401 from Cloudinary itself.
# Find the real values in the Cloudinary console (Dashboard -> Product
# Environment -> "API environment variable"). Paste that whole line and read it
# as cloudinary://<api_key>:<api_secret>@<cloud_name> — the cloud name is the
# account's own name (often a short random string), NOT the brand name.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""