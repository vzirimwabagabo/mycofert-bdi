// Prisma schema for MYCOFERT Burundi.
//
// Provider is PostgreSQL: the app runs behind a load balancer on multiple
// app instances, and SQLite is a single-file, single-writer database that
// cannot be shared between them.
//
// Indexes below are chosen for the actual query patterns:
//   * Inquiry  — dashboard listing sorted by createdAt desc, filtered by
//                status and grouped by type.
//   * PageView — grouped by path, counted in bulk, written on every navigation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  type      String
  product   String?
  message   String
  lang      String   @default("fr")
  status    String   @default("new")
  createdAt DateTime @default(now())

  // Dashboard default view: newest first.
  @@index([createdAt(sort: Desc)])
  // Status filter ("new" badge count, handled toggle).
  @@index([status])
  // "By subject" breakdown.
  @@index([type])
  // Composite for the common "filter by status, newest first" listing.
  @@index([status, createdAt(sort: Desc)])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  lang      String   @default("fr")
  createdAt DateTime @default(now())

  // Top-pages aggregation and path grouping.
  @@index([path])
  // Retention / time-window queries.
  @@index([createdAt])
}

model Product {
  id        String   @id @default(cuid())
  slug      String   @unique
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  imageKey  String   @default("fresh")
  // Optional Cloudinary-hosted image (uploaded via the admin dashboard).
  // Takes precedence over imageKey when set; validated to be an https URL.
  imageUrl  String?
  nameFr    String
  nameEn    String
  taglineFr String   @default("")
  taglineEn String   @default("")
  descFr    String   @default("")
  descEn    String   @default("")
  pointsFr  String   @default("")
  pointsEn  String   @default("")
  formatsFr String   @default("")
  formatsEn String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Public listing: published only, ordered by sortOrder then nameFr.
  @@index([published, sortOrder])
}

model NewsPost {
  id        String   @id @default(cuid())
  slug      String   @unique
  published Boolean  @default(true)
  imageKey  String   @default("training")
  // Optional Cloudinary-hosted image (uploaded via the admin dashboard).
  // Takes precedence over imageKey when set; validated to be an https URL.
  imageUrl  String?
  dateFr    String   @default("")
  dateEn    String   @default("")
  titleFr   String
  titleEn   String
  excerptFr String   @default("")
  excerptEn String   @default("")
  bodyFr    String   @default("")
  bodyEn    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Public listing: published only, newest first.
  @@index([published, createdAt(sort: Desc)])
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
