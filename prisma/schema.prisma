// Prisma schema for MYCOFERT Burundi website
// SQLite datasource configured via DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Inquiries submitted from the website forms.
// type: "product" (product information) | "bulk" (bulk supply) | "fertilizer"
//     | "training" | "partnership"
model Inquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  type      String
  product   String?
  message   String
  lang      String   @default("fr")
  status    String   @default("new")
  createdAt DateTime @default(now())
}

// Lightweight first-party page analytics.
model PageView {
  id        String   @id @default(cuid())
  path      String
  lang      String   @default("fr")
  createdAt DateTime @default(now())
}
